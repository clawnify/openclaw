diff --git a/extensions/whatsapp/src/agent-tools-conversations.ts b/extensions/whatsapp/src/agent-tools-conversations.ts
new file mode 100644
index 0000000000..d5acb8c828
--- /dev/null
+++ b/extensions/whatsapp/src/agent-tools-conversations.ts
@@ -0,0 +1,134 @@
+import type { ChannelAgentTool } from "openclaw/plugin-sdk/channel-contract";
+import { getRuntimeConfig } from "openclaw/plugin-sdk/runtime-config-snapshot";
+import { Type } from "typebox";
+import { getActiveWebListener, resolveWebAccountId } from "./active-listener.js";
+import { areWhatsAppConversationToolsEnabled } from "./conversations-enabled.js";
+import type { ChatSummary, MessageSummary } from "./inbound/conversation-store.js";
+import type { ActiveWebListener } from "./inbound/types.js";
+
+function requireConversationCapableListener(accountIdArg: unknown): ActiveWebListener {
+  if (!areWhatsAppConversationToolsEnabled()) {
+    throw new Error(
+      "WhatsApp conversation tools are disabled. Set OPENCLAW_WHATSAPP_CONVERSATIONS=1 to enable them.",
+    );
+  }
+  const cfg = getRuntimeConfig();
+  const accountId = resolveWebAccountId({
+    cfg,
+    accountId: typeof accountIdArg === "string" ? accountIdArg : null,
+  });
+  const listener = getActiveWebListener(accountId);
+  if (!listener) {
+    throw new Error(`WhatsApp is not linked (account: ${accountId}). Link it first, then retry.`);
+  }
+  return listener;
+}
+
+function readChatJid(value: unknown): string {
+  const jid = typeof value === "string" ? value.trim() : "";
+  if (!jid) {
+    throw new Error("jid is required (a chat JID from whatsapp_list_chats, e.g. 1555...@s.whatsapp.net).");
+  }
+  return jid;
+}
+
+function formatTimestamp(unixSeconds: number): string {
+  if (!unixSeconds) {
+    return "unknown time";
+  }
+  return new Date(unixSeconds * 1000).toISOString();
+}
+
+function formatChatLine(chat: ChatSummary): string {
+  const label = chat.name ? `${chat.name} (${chat.jid})` : chat.jid;
+  const unread = chat.unreadCount > 0 ? ` — ${chat.unreadCount} unread` : "";
+  const preview = chat.lastMessageText ? ` — last: ${chat.lastMessageText}` : "";
+  return `${label}${unread}${preview}`;
+}
+
+function formatMessageLine(msg: MessageSummary): string {
+  const who = msg.fromMe ? "me" : (msg.sender ?? "unknown");
+  const body = msg.text ?? msg.media ?? "";
+  return `[${formatTimestamp(msg.timestamp)}] ${who}: ${body}`;
+}
+
+function createWhatsAppListChatsTool(): ChannelAgentTool {
+  return {
+    label: "WhatsApp List Chats",
+    name: "whatsapp_list_chats",
+    description:
+      "List the WhatsApp conversations currently known to the agent, most recent first. " +
+      "Reads a live in-memory mirror (recent window only — not the full archive). " +
+      "Use the returned JID with whatsapp_read_conversation to inspect a chat.",
+    parameters: Type.Object({
+      accountId: Type.Optional(Type.String()),
+    }),
+    execute: async (_toolCallId, args) => {
+      const { accountId } = args as { accountId?: string };
+      const listener = requireConversationCapableListener(accountId);
+      const chats = await listener.listChats();
+      const text = chats.length
+        ? chats.map(formatChatLine).join("\n")
+        : "No conversations are mirrored yet. They populate as WhatsApp syncs history and new messages arrive.";
+      return {
+        content: [{ type: "text", text }],
+        details: { count: chats.length, chats },
+      };
+    },
+  };
+}
+
+function createWhatsAppReadConversationTool(): ChannelAgentTool {
+  return {
+    label: "WhatsApp Read Conversation",
+    name: "whatsapp_read_conversation",
+    description:
+      "Read recent messages of a WhatsApp conversation (oldest to newest) from the in-memory " +
+      "mirror. Media messages appear as placeholders like <media:image>. Pass a JID from " +
+      "whatsapp_list_chats.",
+    parameters: Type.Object({
+      jid: Type.String({
+        description: "Chat JID, e.g. 15551234567@s.whatsapp.net (direct) or 1203...@g.us (group).",
+      }),
+      limit: Type.Optional(
+        Type.Number({
+          description:
+            "Max messages to return (default 30, capped at 200). Asking for more than the recent window pages older messages in on demand from WhatsApp.",
+        }),
+      ),
+      accountId: Type.Optional(Type.String()),
+    }),
+    execute: async (_toolCallId, args) => {
+      const { jid, limit, accountId } = args as {
+        jid?: unknown;
+        limit?: number;
+        accountId?: string;
+      };
+      const chatJid = readChatJid(jid);
+      const listener = requireConversationCapableListener(accountId);
+      const messages = await listener.readConversation(
+        chatJid,
+        typeof limit === "number" ? limit : undefined,
+      );
+      const text = messages.length
+        ? messages.map(formatMessageLine).join("\n")
+        : `No messages found for ${chatJid} (nothing in the recent window, and no older history returned on demand).`;
+      return {
+        content: [{ type: "text", text }],
+        details: { jid: chatJid, count: messages.length, messages },
+      };
+    },
+  };
+}
+
+/**
+ * WhatsApp conversation read tools, opt-in via OPENCLAW_WHATSAPP_CONVERSATIONS.
+ * Returned only when enabled, so disabled installs don't advertise tools the
+ * agent can't use. Each tool re-checks the gate + requires an active listener.
+ */
+export function createWhatsAppConversationTools(): ChannelAgentTool[] {
+  if (!areWhatsAppConversationToolsEnabled()) {
+    return [];
+  }
+  return [createWhatsAppListChatsTool(), createWhatsAppReadConversationTool()];
+}
diff --git a/extensions/whatsapp/src/agent-tools-groups.ts b/extensions/whatsapp/src/agent-tools-groups.ts
new file mode 100644
index 0000000000..9959062a7c
--- /dev/null
+++ b/extensions/whatsapp/src/agent-tools-groups.ts
@@ -0,0 +1,167 @@
+import type { ChannelAgentTool } from "openclaw/plugin-sdk/channel-contract";
+import { getActiveWebListener, resolveWebAccountId } from "./active-listener.js";
+import { getRuntimeConfig } from "openclaw/plugin-sdk/runtime-config-snapshot";
+import type { ActiveWebListener } from "./inbound/types.js";
+import { Type } from "typebox";
+
+const GROUP_JID_PATTERN = "@g.us";
+
+// Interim build gate: the group tools are opt-in via the
+// OPENCLAW_WHATSAPP_GROUPS env var rather than a channels.whatsapp.actions
+// config flag. Stock OpenClaw core (which we run unmodified) validates
+// channels.whatsapp.actions with a strict zod schema, so introducing a new
+// `groups` key there would be rejected at gateway start. The env gate keeps
+// this plugin installable on stock core. (The upstream PR uses the proper
+// config gate; this divergence disappears when that lands.)
+function areWhatsAppGroupActionsEnabled(): boolean {
+  const raw = process.env.OPENCLAW_WHATSAPP_GROUPS;
+  return raw === "1" || raw === "true";
+}
+
+function requireGroupCapableListener(accountIdArg: unknown): ActiveWebListener {
+  if (!areWhatsAppGroupActionsEnabled()) {
+    throw new Error(
+      "WhatsApp group actions are disabled. Set OPENCLAW_WHATSAPP_GROUPS=1 to enable them.",
+    );
+  }
+  const cfg = getRuntimeConfig();
+  const accountId = resolveWebAccountId({
+    cfg,
+    accountId: typeof accountIdArg === "string" ? accountIdArg : null,
+  });
+  const listener = getActiveWebListener(accountId);
+  if (!listener) {
+    throw new Error(
+      `WhatsApp is not linked (account: ${accountId}). Link it first, then retry.`,
+    );
+  }
+  return listener;
+}
+
+function readParticipants(value: unknown): string[] {
+  if (!Array.isArray(value) || value.length === 0) {
+    throw new Error("participants must be a non-empty array of phone numbers (E.164).");
+  }
+  const participants = value
+    .map((entry) => (typeof entry === "string" ? entry.trim() : ""))
+    .filter(Boolean);
+  if (participants.length === 0) {
+    throw new Error("participants must contain at least one phone number (E.164).");
+  }
+  return participants;
+}
+
+function readGroupJid(value: unknown): string {
+  const jid = typeof value === "string" ? value.trim() : "";
+  if (!jid.endsWith(GROUP_JID_PATTERN)) {
+    throw new Error("group_jid must be a WhatsApp group JID, e.g. 120363012345678901@g.us.");
+  }
+  return jid;
+}
+
+function createWhatsAppGroupCreateTool(): ChannelAgentTool {
+  return {
+    label: "WhatsApp Create Group",
+    name: "whatsapp_group_create",
+    description:
+      "Create a new WhatsApp group with the given subject and participants. Returns the new group JID — use it for future group operations.",
+    parameters: Type.Object({
+      subject: Type.String({ description: "Group name." }),
+      participants: Type.Array(Type.String(), {
+        description: "Phone numbers in E.164 format, e.g. +15551234567.",
+      }),
+      accountId: Type.Optional(Type.String()),
+    }),
+    execute: async (_toolCallId, args) => {
+      const { subject, participants, accountId } = args as {
+        subject?: string;
+        participants?: unknown;
+        accountId?: string;
+      };
+      const trimmedSubject = typeof subject === "string" ? subject.trim() : "";
+      if (!trimmedSubject) {
+        throw new Error("subject is required.");
+      }
+      const listener = requireGroupCapableListener(accountId);
+      const result = await listener.createGroup(trimmedSubject, readParticipants(participants));
+      return {
+        content: [
+          { type: "text", text: `Created WhatsApp group "${result.subject}" (${result.groupJid}).` },
+        ],
+        details: result,
+      };
+    },
+  };
+}
+
+function createWhatsAppGroupAddTool(): ChannelAgentTool {
+  return {
+    label: "WhatsApp Add Group Participants",
+    name: "whatsapp_group_add_participants",
+    description: "Add participants to an existing WhatsApp group.",
+    parameters: Type.Object({
+      group_jid: Type.String({ description: "Group JID, e.g. 120363012345678901@g.us." }),
+      participants: Type.Array(Type.String(), {
+        description: "Phone numbers in E.164 format to add.",
+      }),
+      accountId: Type.Optional(Type.String()),
+    }),
+    execute: async (_toolCallId, args) => {
+      const { group_jid, participants, accountId } = args as {
+        group_jid?: unknown;
+        participants?: unknown;
+        accountId?: string;
+      };
+      const groupJid = readGroupJid(group_jid);
+      const listener = requireGroupCapableListener(accountId);
+      const results = await listener.addGroupParticipants(groupJid, readParticipants(participants));
+      return {
+        content: [
+          {
+            type: "text",
+            text: results.map((r) => `${r.jid ?? "(unknown)"}: ${r.status}`).join("\n"),
+          },
+        ],
+        details: { groupJid, results },
+      };
+    },
+  };
+}
+
+function createWhatsAppGroupInviteLinkTool(): ChannelAgentTool {
+  return {
+    label: "WhatsApp Group Invite Link",
+    name: "whatsapp_group_invite_link",
+    description: "Get the invite link for a WhatsApp group the bot administers.",
+    parameters: Type.Object({
+      group_jid: Type.String({ description: "Group JID, e.g. 120363012345678901@g.us." }),
+      accountId: Type.Optional(Type.String()),
+    }),
+    execute: async (_toolCallId, args) => {
+      const { group_jid, accountId } = args as { group_jid?: unknown; accountId?: string };
+      const groupJid = readGroupJid(group_jid);
+      const listener = requireGroupCapableListener(accountId);
+      const result = await listener.getGroupInviteCode(groupJid);
+      return {
+        content: [{ type: "text", text: result.inviteLink }],
+        details: { groupJid, ...result },
+      };
+    },
+  };
+}
+
+/**
+ * WhatsApp group-management agent tools, opt-in via OPENCLAW_WHATSAPP_GROUPS.
+ * Returned only when enabled, so disabled installs don't advertise tools the
+ * agent can't use. Each tool re-checks the gate + requires an active listener.
+ */
+export function createWhatsAppGroupTools(): ChannelAgentTool[] {
+  if (!areWhatsAppGroupActionsEnabled()) {
+    return [];
+  }
+  return [
+    createWhatsAppGroupCreateTool(),
+    createWhatsAppGroupAddTool(),
+    createWhatsAppGroupInviteLinkTool(),
+  ];
+}
diff --git a/extensions/whatsapp/src/agent-tools-profile.ts b/extensions/whatsapp/src/agent-tools-profile.ts
new file mode 100644
index 0000000000..1a636325f5
--- /dev/null
+++ b/extensions/whatsapp/src/agent-tools-profile.ts
@@ -0,0 +1,257 @@
+import { readFile } from "node:fs/promises";
+import type { ChannelAgentTool } from "openclaw/plugin-sdk/channel-contract";
+import {
+  resolveAgentAvatar,
+  resolveAgentIdentity,
+  resolveDefaultAgentId,
+} from "openclaw/plugin-sdk/agent-runtime";
+import { getRuntimeConfig } from "openclaw/plugin-sdk/runtime-config-snapshot";
+import type { OpenClawConfig } from "openclaw/plugin-sdk/config-contracts";
+import { Type } from "typebox";
+import { getActiveWebListener, resolveWebAccountId } from "./active-listener.js";
+import type { ActiveWebListener } from "./inbound/types.js";
+
+// Build gate, mirroring the group + conversation tools: WhatsApp profile access
+// is opt-in via OPENCLAW_WHATSAPP_PROFILE rather than a channels.whatsapp.actions
+// config flag (stock core's strict zod schema would reject a new key there). It
+// gets its OWN gate because the setters WRITE to WhatsApp's servers and, if the
+// linked number is the customer's personal or company WhatsApp, would overwrite
+// THEIR profile — so enabling groups or conversation reading must not silently
+// grant profile writes. Clawnify owns this WhatsApp plugin fork, so this gate is
+// the permanent mechanism (not an interim step).
+function areWhatsAppProfileToolsEnabled(): boolean {
+  const raw = process.env.OPENCLAW_WHATSAPP_PROFILE;
+  return raw === "1" || raw === "true";
+}
+
+function requireProfileCapableListener(accountIdArg: unknown): {
+  listener: ActiveWebListener;
+  cfg: OpenClawConfig;
+} {
+  if (!areWhatsAppProfileToolsEnabled()) {
+    throw new Error(
+      "WhatsApp profile tools are disabled. Set OPENCLAW_WHATSAPP_PROFILE=1 to enable them.",
+    );
+  }
+  const cfg = getRuntimeConfig();
+  const accountId = resolveWebAccountId({
+    cfg,
+    accountId: typeof accountIdArg === "string" ? accountIdArg : null,
+  });
+  const listener = getActiveWebListener(accountId);
+  if (!listener) {
+    throw new Error(`WhatsApp is not linked (account: ${accountId}). Link it first, then retry.`);
+  }
+  return { listener, cfg };
+}
+
+function dataUriToBuffer(uri: string): Buffer {
+  const comma = uri.indexOf(",");
+  if (comma < 0) {
+    throw new Error("Malformed data: URI for picture.");
+  }
+  const isBase64 = /;base64/i.test(uri.slice(0, comma));
+  return Buffer.from(uri.slice(comma + 1), isBase64 ? "base64" : "utf-8");
+}
+
+// Resolve the explicit `picture` argument to a Baileys media payload. Only
+// http(s) URLs and data: URIs are accepted from tool input — arbitrary local
+// paths are rejected to avoid path traversal. To use a local workspace image,
+// set it as the agent's identity avatar (security-checked by the host) and call
+// the tool with no `picture`.
+function resolveExplicitPicture(raw: string): Buffer | { url: string } {
+  const value = raw.trim();
+  if (/^https?:\/\//i.test(value)) {
+    return { url: value };
+  }
+  if (/^data:/i.test(value)) {
+    return dataUriToBuffer(value);
+  }
+  throw new Error(
+    "picture must be an http(s) URL or a data: URI. To use a local image, set it as this agent's identity avatar and call the tool without `picture`.",
+  );
+}
+
+// Fall back to the agent's configured identity avatar (config → workspace
+// IDENTITY.md), resolved + validated by the host (workspace-scoped, size +
+// extension limits). Returns a Buffer (local/data) or a remote URL.
+async function resolveIdentityPicture(
+  cfg: OpenClawConfig,
+  agentId: string,
+): Promise<Buffer | { url: string }> {
+  const avatar = resolveAgentAvatar(cfg, agentId);
+  switch (avatar.kind) {
+    case "local":
+      return readFile(avatar.filePath);
+    case "remote":
+      return { url: avatar.url };
+    case "data":
+      return dataUriToBuffer(avatar.url);
+    default:
+      throw new Error(
+        "No picture provided and this agent has no usable identity avatar configured. " +
+          "Pass `picture` (http(s) URL or data: URI), or set the agent's identity avatar.",
+      );
+  }
+}
+
+// WhatsApp itself is the source of truth for the linked account's profile. This
+// tool lets the agent SEE what's already set (e.g. a company WhatsApp that's
+// already branded) so it can decide NOT to overwrite it.
+function createWhatsAppGetProfileTool(): ChannelAgentTool {
+  return {
+    label: "WhatsApp Get Profile",
+    name: "whatsapp_get_profile",
+    description:
+      "Read the linked WhatsApp account's current profile: its display name and whether a " +
+      "profile picture is set. Use this before changing anything — if the number already has a " +
+      "name/picture (e.g. a company WhatsApp), leave it as-is rather than overwriting it.",
+    parameters: Type.Object({
+      accountId: Type.Optional(Type.String()),
+    }),
+    execute: async (_toolCallId, args) => {
+      const { accountId } = args as { accountId?: string };
+      const { listener } = requireProfileCapableListener(accountId);
+      const name = listener.getProfileName();
+      const pictureUrl = await listener.getProfilePictureUrl();
+      const hasPicture = Boolean(pictureUrl);
+      const text = `WhatsApp profile — name: ${name ? `"${name}"` : "(unset)"}, picture: ${
+        hasPicture ? "set" : "none"
+      }.`;
+      return {
+        content: [{ type: "text", text }],
+        details: { name: name ?? null, hasPicture, pictureUrl: pictureUrl ?? null },
+      };
+    },
+  };
+}
+
+function createWhatsAppSetProfileNameTool(): ChannelAgentTool {
+  return {
+    label: "WhatsApp Set Profile Name",
+    name: "whatsapp_set_profile_name",
+    description:
+      "Set the WhatsApp display name of the linked account. Omit `name` to use this agent's " +
+      "configured identity name. Refuses to overwrite a name that is already set unless " +
+      "`force` is true. WARNING: this changes the name on the linked WhatsApp account itself — " +
+      "if a personal or company number is linked, it overwrites that account's real name.",
+    parameters: Type.Object({
+      name: Type.Optional(
+        Type.String({ description: "New display name. Omit to use the agent's identity name." }),
+      ),
+      force: Type.Optional(
+        Type.Boolean({ description: "Replace an existing name. Default false (won't overwrite)." }),
+      ),
+      accountId: Type.Optional(Type.String()),
+    }),
+    execute: async (_toolCallId, args) => {
+      const { name, force, accountId } = args as {
+        name?: string;
+        force?: boolean;
+        accountId?: string;
+      };
+      const { listener, cfg } = requireProfileCapableListener(accountId);
+      const resolved =
+        typeof name === "string" && name.trim()
+          ? name.trim()
+          : resolveAgentIdentity(cfg, resolveDefaultAgentId(cfg))?.name?.trim();
+      if (!resolved) {
+        throw new Error(
+          "No name provided and this agent has no identity name configured. Pass `name`.",
+        );
+      }
+      const current = listener.getProfileName();
+      if (current && current.trim() && current.trim() !== resolved && force !== true) {
+        return {
+          content: [
+            {
+              type: "text",
+              text: `WhatsApp name is already set to "${current}". Pass force:true to replace it with "${resolved}".`,
+            },
+          ],
+          details: { changed: false, current, requested: resolved },
+        };
+      }
+      await listener.setProfileName(resolved);
+      return {
+        content: [{ type: "text", text: `WhatsApp display name set to "${resolved}".` }],
+        details: { changed: true, name: resolved },
+      };
+    },
+  };
+}
+
+function createWhatsAppSetProfilePictureTool(): ChannelAgentTool {
+  return {
+    label: "WhatsApp Set Profile Picture",
+    name: "whatsapp_set_profile_picture",
+    description:
+      "Set the WhatsApp profile picture of the linked account from an http(s) URL or data: URI. " +
+      "Omit `picture` to use this agent's configured identity avatar. WhatsApp crops it to a " +
+      "square automatically. Refuses to overwrite an existing picture unless `force` is true. " +
+      "WARNING: this changes the photo on the linked WhatsApp account itself — if a personal or " +
+      "company number is linked, it overwrites that account's real photo.",
+    parameters: Type.Object({
+      picture: Type.Optional(
+        Type.String({
+          description:
+            "Image as an http(s) URL or data: URI. Omit to use the agent's identity avatar.",
+        }),
+      ),
+      force: Type.Optional(
+        Type.Boolean({
+          description: "Replace an existing picture. Default false (won't overwrite).",
+        }),
+      ),
+      accountId: Type.Optional(Type.String()),
+    }),
+    execute: async (_toolCallId, args) => {
+      const { picture, force, accountId } = args as {
+        picture?: string;
+        force?: boolean;
+        accountId?: string;
+      };
+      const { listener, cfg } = requireProfileCapableListener(accountId);
+      if (force !== true && (await listener.getProfilePictureUrl())) {
+        return {
+          content: [
+            {
+              type: "text",
+              text: "WhatsApp already has a profile picture set. Pass force:true to replace it.",
+            },
+          ],
+          details: { changed: false },
+        };
+      }
+      const content =
+        typeof picture === "string" && picture.trim()
+          ? resolveExplicitPicture(picture)
+          : await resolveIdentityPicture(cfg, resolveDefaultAgentId(cfg));
+      await listener.setProfilePicture(content);
+      const source = Buffer.isBuffer(content) ? "image data" : content.url;
+      return {
+        content: [{ type: "text", text: `WhatsApp profile picture updated (from ${source}).` }],
+        details: { changed: true, source },
+      };
+    },
+  };
+}
+
+/**
+ * WhatsApp profile tools, opt-in via OPENCLAW_WHATSAPP_PROFILE. Returned only
+ * when enabled, so disabled installs don't advertise tools the agent can't use.
+ * Each tool re-checks the gate + requires an active listener. The setters are
+ * non-destructive by default (refuse to overwrite an existing name/picture
+ * unless force:true) because WhatsApp is the source of truth for the account's
+ * branding.
+ */
+export function createWhatsAppProfileTools(): ChannelAgentTool[] {
+  if (!areWhatsAppProfileToolsEnabled()) {
+    return [];
+  }
+  return [
+    createWhatsAppGetProfileTool(),
+    createWhatsAppSetProfileNameTool(),
+    createWhatsAppSetProfilePictureTool(),
+  ];
+}
